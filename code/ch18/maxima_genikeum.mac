;; maxima_genikeum.mac — Γενικευμένα Ολοκληρώματα (Κεφ. 18)
;; Ματζάκος, Ν. (2026). Στοιχεία Γραμμικής Άλγεβρας, Διαφορικού & Ολοκληρωτικού Λογισμού. NewTech Publications.

/* 1. Ολοκλήρωμα σε άπειρο διάστημα */
print("1. integrate(1/x^2, x, 1, inf) =",
      integrate(1/x^2, x, 1, inf));
print("2. integrate(1/x,   x, 1, inf) =",
      integrate(1/x,   x, 1, inf));

/* 2. Ολοκλήρωμα με ιδιαίτερο σημείο */
print("3. integrate(1/sqrt(x), x, 0, 1) =",
      integrate(1/sqrt(x), x, 0, 1));
print("4. integrate(1/x, x, 0, 1) =",
      integrate(1/x, x, 0, 1));

/* 3. p-κριτήριο */
for p: [1/2, 3/2, 2, 3] do (
  val: integrate(1/x^p, x, 1, inf),
  print("p =", p, "->", val)
)$

/* 4. Εκθετικά */
print("∫e^(-x) dx από 0 ως ∞ =",
      integrate(exp(-x), x, 0, inf));
print("∫x·e^(-x) dx από 0 ως ∞ =",
      integrate(x*exp(-x), x, 0, inf));
print("∫x²·e^(-x) dx από 0 ως ∞ =",
      integrate(x^2*exp(-x), x, 0, inf));

/* 5. Γράφημα σύγκρισης */
plot2d([1/x^2, 1/x], [x, 1, 10],
       [legend, "1/x² (σύγκλ.)", "1/x (αποκλ.)"],
       [title, "Σύγκριση 1/x και 1/x²"])$

/* ============================================================ */
/* ΣΥΜΠΛΗΡΩΜΑ — Γάμμα, Βήτα και αριθμητική επαλήθευση           */
/*   gamma(n), beta(m,n), romberg(f,x,a,b)                       */
/* ============================================================ */

load(romberg)$

/* 1. Η Γάμμα επεκτείνει το παραγοντικό σε μη ακέραιους.        */
print("Γ(1/2) =", gamma(1/2), " = sqrt(%pi) =", float(sqrt(%pi)))$
print("Γ(5)   =", gamma(5),   " = 4! =", 4!)$
print("Γ(5/2) =", gamma(5/2), " =", float(gamma(5/2)))$

/* Η αναδρομική σχέση Γ(s+1) = s·Γ(s)                            */
print("")$
print("Γ(7/2) =", float(gamma(7/2)),
      "   (5/2)·Γ(5/2) =", float((5/2)*gamma(5/2)))$

/* 2. Η Βήτα και η σχέση της με τη Γάμμα                         */
print("")$
print("B(2,3) =", beta(2,3), "=", float(beta(2,3)))$
print("Γ(2)Γ(3)/Γ(5) =", float(gamma(2)*gamma(3)/gamma(5)))$

/* 3. Ορισμός της Γάμμα ως γενικευμένο ολοκλήρωμα               */
print("")$
print("∫_0^inf x^(1/2-1) e^(-x) dx =",
      integrate(x^(1/2-1)*exp(-x), x, 0, inf))$

/* 4. Αριθμητική επαλήθευση σε πεπερασμένο διάστημα (romberg)   */
print("")$
print("∫_0^5 e^(-x^2) dx (romberg) =", romberg(exp(-x^2), x, 0, 5))$
print("∫_0^inf e^(-x^2) dx        =", integrate(exp(-x^2), x, 0, inf),
      "=", float(sqrt(%pi)/2))$

/* 5. Κριτήριο σύγκρισης: e^(-x)/x <= e^(-x) για x>=1           */
print("")$
print("∫_1^inf e^(-x) dx     =", float(integrate(exp(-x), x, 1, inf)),
      "= e^(-1) =", float(exp(-1)))$
print("∫_1^20 e^(-x)/x dx    =", romberg(exp(-x)/x, x, 1, 20),
      "  (μικρότερο, άρα συγκλίνει)")$
