/* Κεφάλαιο 15 — Θεμελιώδες Θεώρημα Λογισμού */
/* Ματζάκος, Ν. (2026). Στοιχεία Γραμμικής Άλγεβρας, Διαφορικού & Ολοκληρωτικού Λογισμού. NewTech Publications. */
/* ΘΘΛ Μέρος Α */
F_expr : integrate(t^2, t, 0, x);
print("F(x)=int_0^x t^2:", F_expr);
print("F'(x)=", diff(F_expr,x), " (= x^2 ?)");
F2 : integrate(sin(t),t,0,x);
print("F(x)=int_0^x sin(t):", F2);
print("F'(x)=", diff(F2,x));
/* ΘΘΛ Μέρος Β */
print("int_1^3 x^2     =", integrate(x^2,x,1,3));
print("int_0^pi cos(x) =", integrate(cos(x),x,0,%pi));
print("int_1^e 1/x     =", integrate(1/x,x,1,%e));
print("int_0^1 e^x     =", integrate(exp(x),x,0,1));
print("int_-1^1 x^3    =", integrate(x^3,x,-1,1));
/* Εμβαδόν μεταξύ x^2 και 2x */
intersect : solve(x^2=2*x,x);
print("Τομές x^2=2x:", intersect);
print("Εμβαδόν =", integrate(2*x-x^2,x,0,2));
plot2d([x^2,2*x],[x,-0.5,2.5],[legend,"x^2","2x"],[title,"ΘΘΛ"]);

/* ============================================================ */
/* ΣΥΜΠΛΗΡΩΜΑ — Συνάρτηση συσσώρευσης και το ΘΘΟΛ               */
/*   integrate(f,t,0,x), diff, subst, float                      */
/* ============================================================ */

/* Δηλώνουμε ότι το άνω όριο είναι θετικό· διαφορετικά η Maxima  */
/* ρωτά «Is x positive, negative or zero?» και περιμένει απάντηση.*/
assume(x > 0)$

/* Μέρος Α: F(x) = ∫_0^x f(t) dt  =>  F'(x) = f(x)              */
F : integrate(sin(t), t, 0, x)$
print("F(x) = ∫_0^x sin(t) dt =", F)$
print("F'(x) =", trigsimp(diff(F, x)), "   (δηλαδή sin(x))")$

/* Τιμές της συνάρτησης συσσώρευσης με subst                     */
print("")$
for a in [%pi/4, %pi/2, %pi] do
  print("  F(", a, ") =", subst(a, x, F), "=", float(subst(a, x, F)))$

/* Μέρος Β: ∫_a^b f = G(b) - G(a)                                */
print("")$
G : integrate(x^3 - 2*x, x)$
print("Αντιπαράγωγος G(x) =", G)$
print("G(3) - G(1) =", subst(3, x, G) - subst(1, x, G),
      "=", float(subst(3, x, G) - subst(1, x, G)))$
print("integrate(...,1,3) =", integrate(x^3 - 2*x, x, 1, 3))$

/* Σύνθετο άνω όριο: κανόνας αλυσίδας */
print("")$
H : integrate(exp(-t^2), t, 0, x^2)$
print("d/dx ∫_0^{x^2} e^{-t^2} dt =", diff(H, x),
      "   [αναμενόμενο 2x·e^{-x^4}]")$
