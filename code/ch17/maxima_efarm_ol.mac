;; maxima_efarm_ol.mac — Εφαρμογές Ολοκληρωτικού Λογισμού (Κεφ. 17)
;; Ματζάκος, Ν. (2026). Στοιχεία Γραμμικής Άλγεβρας, Διαφορικού & Ολοκληρωτικού Λογισμού. NewTech Publications.

/* 1. Εμβαδόν μεταξύ δύο καμπυλών */
f: x^2$
g: x+2$
pts: solve(f = g, x);
[a, b]: [rhs(pts[1]), rhs(pts[2])];
A: integrate(g - f, x, a, b);
print("Εμβαδόν =", A);

/* Γράφημα */
plot2d([f, g, [parametric, t, 0, [t, a, b]]],
       [x, a-0.5, b+0.5],
       [style, [lines,2,1], [lines,2,2], [lines,1,3]],
       [legend, "f(x)=x²", "g(x)=x+2"],
       [title, "Εμβαδόν μεταξύ δύο καμπυλών"])$

/* 2. Όγκος περιστροφής (δίσκοι) */
f2: sqrt(x)$
V: %pi * integrate(f2^2, x, 0, 4);
print("Όγκος V =", V, "≈", float(V));

/* 3. Μήκος καμπύλης */
f3: x^(3/2)$
df3: diff(f3, x)$
L: integrate(sqrt(1 + df3^2), x, 0, 4);
print("Μήκος L =", ratsimp(L));

/* 4. Ροπή αδράνειας */
assume(rho > 0, L_len > 0)$
I: rho * integrate(x^2, x, 0, L_len);
print("Ροπή αδράνειας I =", I);

/* ============================================================ */
/* ΣΥΜΠΛΗΡΩΜΑ — Αριθμητική ολοκλήρωση με romberg                */
/* ============================================================ */

load(romberg)$

/* Όταν δεν υπάρχει στοιχειώδης αντιπαράγωγος, ολοκληρώνουμε    */
/* αριθμητικά. Η romberg είναι εκλέπτυνση του κανόνα τραπεζίου. */
print("∫_0^1 e^(-x^2) dx  =", romberg(exp(-x^2), x, 0, 1))$
print("  (αναφορά: 0.7468241328)")$

print("")$
print("∫_0^1 sin(x)/x dx  =", romberg(sin(x)/x, x, 1e-12, 1))$
print("∫_0^2 sqrt(1+x^4) dx =", romberg(sqrt(1+x^4), x, 0, 2))$

/* Μήκος τόξου της y = x^2 στο [0,1]                             */
print("")$
y : x^2$
ds : sqrt(1 + diff(y, x)^2)$
print("Μήκος τόξου (romberg)  =", romberg(ds, x, 0, 1))$
print("Μήκος τόξου (συμβολικά)=", float(integrate(ds, x, 0, 1)))$

/* Έλεγχος ακρίβειας: μεταβάλλουμε την ανοχή                     */
print("")$
rombergtol : 1e-10$
print("Με rombergtol=1e-10: ∫_0^1 e^(-x^2) dx =", romberg(exp(-x^2), x, 0, 1))$

/* Εμβαδόν μεταξύ καμπυλών: πρώτα τα σημεία τομής με solve      */
print("")$
pts : map(rhs, solve(x^2 = x, x))$
print("Τομές y=x^2 και y=x:", pts)$
print("Εμβαδόν =", integrate(x - x^2, x, 0, 1), "=",
      float(integrate(x - x^2, x, 0, 1)))$
