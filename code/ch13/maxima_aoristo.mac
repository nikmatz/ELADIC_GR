/* Κεφάλαιο 13 — Αόριστο Ολοκλήρωμα */
/* Ματζάκος, Ν. (2026). Στοιχεία Γραμμικής Άλγεβρας, Διαφορικού & Ολοκληρωτικού Λογισμού. NewTech Publications. */
print("int(x^5)         =", integrate(x^5,x));
print("int(1/x)         =", integrate(1/x,x));
print("int(e^x)         =", integrate(exp(x),x));
print("int(sin(x))      =", integrate(sin(x),x));
print("int(cos(x))      =", integrate(cos(x),x));
print("int(sin(2x+1))   =", integrate(sin(2*x+1),x));
print("int(x*e^(x^2))   =", integrate(x*exp(x^2),x));
print("int(x/sqrt(x^2+4))=",integrate(x/sqrt(x^2+4),x));
print("int(x*e^x)       =", integrate(x*exp(x),x));
print("int(x*sin(x))    =", integrate(x*sin(x),x));
print("int(x^2*log(x))  =", integrate(x^2*log(x),x));
print("int(log(x))      =", integrate(log(x),x));
result : integrate(x^3*exp(x),x);
print("Επαλήθευση:", ratsimp(diff(result,x)-x^3*exp(x))=0);

/* ============================================================ */
/* ΣΥΜΠΛΗΡΩΜΑ — Αντικατάσταση, επαλήθευση, οικογένεια F+c       */
/*   changevar, solve, plot2d                                    */
/* ============================================================ */

/* 1. changevar: αλλαγή μεταβλητής σε ΑΝΕΚΤΕΛΕΣΤΟ ολοκλήρωμα.   */
/*    Γράφουμε 'integrate (με απόστροφο) για να μην υπολογιστεί. */
I : 'integrate(2*x*exp(x^2), x)$
print("Αρχικό:", I)$
J : changevar(I, u = x^2, u, x)$
print("Μετά την u = x^2:", J)$
print("Αποτέλεσμα:", ev(J, integrate))$

/* 2. Τριγωνομετρική αντικατάσταση                               */
K : 'integrate(cos(x)*sin(x)^3, x)$
print("")$
print("∫ cos(x)sin^3(x) dx =", ev(changevar(K, u = sin(x), u, x), integrate))$

/* 3. Επαλήθευση με παραγώγιση — ο ασφαλέστερος έλεγχος         */
F : integrate(x*exp(x), x)$
print("")$
print("∫ x·e^x dx =", F, "+ c")$
print("Έλεγχος: d/dx F - f =", ratsimp(diff(F, x) - x*exp(x)))$

/* 4. Ποιο μέλος της οικογένειας περνά από δοσμένο σημείο;      */
Fg : integrate(3*x^2 - 2*x, x)$
sol : solve(subst(1, x, Fg) + c = 5, c)$
print("")$
print("F(x) =", Fg, "+ c    με F(1)=5  =>", sol)$

/* 5. Γραφική εικόνα: ίδια καμπύλη, κατακόρυφες μετατοπίσεις    */
plot2d([Fg-3, Fg, Fg+3], [x, -1.5, 2.5],
       [legend, "F-3", "F", "F+3"],
       [title, "Οικογένεια αντιπαραγώγων F(x)+c"])$
