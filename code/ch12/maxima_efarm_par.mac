/* Κεφάλαιο 12 — Εφαρμογές Παραγώγου */
/* Ματζάκος, Ν. (2026). Στοιχεία Γραμμικής Άλγεβρας, Διαφορικού & Ολοκληρωτικού Λογισμού. NewTech Publications. */
/* 1. Σειρά Taylor */
print("e^x    ≈", taylor(exp(x),x,0,6));
print("sin(x) ≈", taylor(sin(x),x,0,7));
print("cos(x) ≈", taylor(cos(x),x,0,6));
print("ln(1+x)≈", taylor(log(1+x),x,0,6));
/* 2. L'Hopital */
print("lim sin(x)/x    =", limit(sin(x)/x,x,0));
print("lim (e^x-1)/x   =", limit((exp(x)-1)/x,x,0));
print("lim (1-cos(x))/x^2=",limit((1-cos(x))/x^2,x,0));
print("lim x*e^(-x) x->inf=",limit(x*exp(-x),x,inf));
/* 3. Βελτιστοποίηση */
A : l*(10-l); dA:diff(A,l); l_opt:solve(dA=0,l);
print("Βέλτιστο:",l_opt,"A_max=",ev(A,l_opt[1]));
/* 4. Newton x^3-2=0 */
f(t):=t^3-2; df(t):=diff(f(t),t);
xi:1.5;
for i:1 thru 8 do (xi:xi-f(xi)/df(xi), print("x_",i,"=",xi));

/* ============================================================ */
/* ΣΥΜΠΛΗΡΩΜΑ — Υποθέσεις, αριθμητική ρίζα, δεκαδικά            */
/*   assume, find_root, float                                    */
/* ============================================================ */

/* 1. assume: δηλώνουμε τι ξέρουμε, ώστε η Maxima να μη ρωτά.   */
assume(x > 0)$
print("Με assume(x>0):  d/dx log(x) =", diff(log(x), x))$
print("  όριο x*log(x) καθώς x->0+ :", limit(x*log(x), x, 0, plus))$
print("  sqrt(x^2) =", radcan(sqrt(x^2)))$
forget(x > 0)$

/* 2. find_root: αριθμητική ρίζα σε διάστημα όπου αλλάζει πρόσημο */
f(x) := x^3 - 2*x - 5$
print("")$
print("f(2) =", f(2), "  f(3) =", f(3), " -> αλλαγή προσήμου στο [2,3]")$
r : find_root(f(x), x, 2, 3)$
print("Ρίζα (find_root):", r, "   f(ρίζα) =", float(f(r)))$

/* Σύγκριση με τη συμβολική λύση: η κυβική έχει μία πραγματική   */
/* και δύο μιγαδικές ρίζες. Η realroots δίνει μόνο την πραγματική.*/
print("Πραγματική ρίζα (realroots):", float(map(rhs, realroots(f(x)))))$

/* 3. Εξίσωση που ΔΕΝ λύνεται συμβολικά                          */
print("")$
print("Λύση της cos(x) = x :", find_root(cos(x) - x, x, 0, 1))$
print("Λύση της e^x = 3x   :", find_root(exp(x) - 3*x, x, 0, 1))$

/* 4. Βελτιστοποίηση: κρίσιμο σημείο και δεκαδική τιμή          */
g : x^2 - 4*x + 7$
c : rhs(first(solve(diff(g, x) = 0, x)))$
print("")$
print("Ελάχιστο της g στο x =", c, ", g =", float(subst(c, x, g)))$
