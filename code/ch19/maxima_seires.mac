/* maxima_seires.mac — Ακολουθίες, Σειρές και Κριτήρια Σύγκλισης (Κεφ. 19) */
/* Ματζάκος, Ν. (2026). Στοιχεία Γραμμικής Άλγεβρας, Διαφορικού & Ολοκληρωτικού Λογισμού. NewTech Publications. */
/* Εντολές: limit(a,n,inf), sum(a,n,1,inf) με simpsum, makelist(), abs(), float() */

load(simplify_sum)$

/* Μερικό άθροισμα S_N αριθμητικά (γρήγορο, χωρίς ρητούς αριθμούς) */
psum(f, N) := block([s : 0.0, k],
                    for k : 1 thru N do s : s + float(subst(k, n, f)),
                    s)$

print("============================================================")$
print("Α. ΑΚΟΛΟΥΘΙΕΣ — ΟΡΙΑ ΚΑΙ ΠΡΩΤΟΙ ΟΡΟΙ")$
print("============================================================")$

print("lim n/(n+1)     =", limit(n/(n+1), n, inf),     "   (1)")$
print("lim (1+1/n)^n   =", limit((1+1/n)^n, n, inf),   "   (%e = ", float(%e), ")")$
print("lim n^2/e^n     =", limit(n^2/exp(n), n, inf),  "   (0)")$
print("lim (-1)^n/n    =", limit((-1)^n/n, n, inf),    "   (0)")$

print("")$
print("Οι πρώτοι 10 όροι (makelist):")$
print("  n/(n+1)   :", float(makelist(n/(n+1), n, 1, 10)))$
print("  (1+1/n)^n :", float(makelist((1+1/n)^n, n, 1, 10)))$
print("  n^2/e^n   :", float(makelist(n^2/exp(n), n, 1, 10)))$
print("  (-1)^n/n  :", float(makelist((-1)^n/n, n, 1, 10)))$
print("Η (-1)^n/n εναλλάσσει πρόσημο αλλά |a_n| = 1/n -> 0, άρα a_n -> 0.")$

print("")$
print("============================================================")$
print("Β. ΓΕΩΜΕΤΡΙΚΕΣ ΚΑΙ ΤΗΛΕΣΚΟΠΙΚΕΣ ΣΕΙΡΕΣ")$
print("============================================================")$

/* Χωρίς το simpsum η Maxima τυπώνει το άθροισμα ανεκτέλεστο */
S1 : ev(sum((1/2)^n, n, 0, inf), simpsum)$
S2 : ev(sum((2/3)^n, n, 0, inf), simpsum)$
print("Σ_{n=0}^inf (1/2)^n =", S1, "   τύπος a/(1-r) =", 1/(1-1/2),
      "   ίσα:", is(equal(S1, 1/(1-1/2))))$
print("Σ_{n=0}^inf (2/3)^n =", S2, "   τύπος a/(1-r) =", 1/(1-2/3),
      "   ίσα:", is(equal(S2, 1/(1-2/3))))$
print("   (αναμενόμενα 2 και 3)")$

print("")$
print("Μερικά αθροίσματα της Σ(1/2)^n (πλησιάζουν το 2):")$
for N in [5, 10, 20] do
  print("   S_", N, "=", float(ev(sum((1/2)^n, n, 0, N), simpsum)))$

print("")$
print("Τηλεσκοπική: Σ_{n=1}^inf 1/(n(n+1))")$
T : simplify_sum(sum(1/(n*(n+1)), n, 1, inf))$
TN : simplify_sum(sum(1/(n*(n+1)), n, 1, N))$
print("   Άθροισμα =", T, "   (αναμενόμενο 1)")$
print("   S_N      =", TN, "   = 1 - 1/(N+1), αφού 1/(n(n+1)) = 1/n - 1/(n+1)")$
for N in [10, 100, 1000] do
  print("   S_", N, "=", float(subst(N, 'N, TN)))$

print("")$
print("============================================================")$
print("Γ. ΚΡΙΤΗΡΙΟ ΛΟΓΟΥ ΚΑΙ Η ΣΕΙΡΑ ΤΟΥ BASEL")$
print("============================================================")$

/* Σ n!/n^n : λόγος -> 1/e < 1, συγκλίνει */
L1 : limit( ((n+1)!/(n+1)^(n+1)) / (n!/n^n), n, inf)$
print("Σ n!/n^n : L =", L1, "=", float(L1), "  < 1  -> ΣΥΓΚΛΙΝΕΙ   (1/e)")$

/* Σ n^n/n! : λόγος -> e > 1, αποκλίνει */
L2 : limit( ((n+1)^(n+1)/(n+1)!) / (n^n/n!), n, inf)$
print("Σ n^n/n! : L =", L2, "=", float(L2), "  > 1  -> ΑΠΟΚΛΙΝΕΙ   (e)")$
print("Οι δύο σειρές είναι αντίστροφες η μία της άλλης, και ο λόγος τους")$
print("αντιστρέφεται: 1/e και e. Μόνο η πρώτη συγκλίνει.")$

print("")$
print("Αριθμητικοί λόγοι a_(n+1)/a_n για την Σ n!/n^n:")$
for N in [5, 20, 100] do
  print("   n =", N, ": λόγος =",
        float( ((N+1)!/(N+1)^(N+1)) / (N!/N^N) ), "   -> 1/e =", float(1/%e))$

print("")$
print("Σειρά Basel: Σ_{n=1}^inf 1/n^2")$
B : ev(sum(1/n^2, n, 1, inf), simpsum)$
print("   Άθροισμα =", B, "=", float(B), "   (%pi^2/6)")$
for N in [10, 100, 1000] do
  print("   S_", N, "=", psum(1/n^2, N),
        "   σφάλμα =", abs(psum(1/n^2, N) - float(%pi^2/6)))$
print("Το σφάλμα φθίνει σαν 1/N (ουρά ~ ∫_N^inf dx/x^2 = 1/N).")$

print("")$
print("============================================================")$
print("Δ. ΕΝΑΛΛΑΣΣΟΥΣΑ ΑΡΜΟΝΙΚΗ ΕΝΑΝΤΙ ΑΡΜΟΝΙΚΗΣ")$
print("============================================================")$

A : simplify_sum(sum((-1)^(n-1)/n, n, 1, inf))$
print("Σ_{n=1}^inf (-1)^(n-1)/n =", A, "=", float(A), "   (log(2))")$
print("")$
print("Κριτήριο Leibniz:  |S - S_N| <= b_(N+1) = 1/(N+1)")$
for N in [10, 100, 1000] do
  print("   N =", N, ": S_N =", psum((-1)^(n-1)/n, N),
        "  |S-S_N| =", abs(psum((-1)^(n-1)/n, N) - float(log(2))),
        "  b_(N+1) =", float(1/(N+1)),
        "  ισχύει:", is(abs(psum((-1)^(n-1)/n, N) - float(log(2)))
                        <= float(1/(N+1))))$

print("")$
print("Αρμονική Σ 1/n — ίδιοι όροι κατ' απόλυτη τιμή, αλλά ΑΠΟΚΛΙΝΕΙ:")$
for N in [10, 100, 1000] do
  print("   N =", N, ": H_N =", psum(1/n, N),
        "   log(N)+γ =", float(log(N) + 0.5772156649))$
print("")$
print("ΔΙΑΦΟΡΑ: στην εναλλάσσουσα τα πρόσημα αλληλοαναιρούνται και τα S_N")$
print("σταθεροποιούνται στο log(2) ~ 0.6931. Στην αρμονική τα S_N αυξάνουν")$
print("χωρίς φράγμα (σαν log N), έστω και πολύ αργά.")$

print("")$
print("============================================================")$
print("Ε. ΣΥΜΠΛΗΡΩΜΑ — ο ορισμός ε-N αριθμητικά")$
print("============================================================")$
a(m) := (2*m + 1)/(m + 3)$
Lim : limit(a(m), m, inf)$
print("a_m = (2m+1)/(m+3),  όριο =", Lim, "   (2)")$
print("Πρώτοι 8 όροι:", float(makelist(a(m), m, 1, 8)))$
for eps in [0.1, 0.01, 0.001] do
  block([N : 1],
    while abs(float(a(N) - Lim)) >= eps do N : N + 1,
    print("   ε =", eps, "-> πρώτο N με |a_N - L| < ε :", N,
          "   |a_N-L| =", float(abs(a(N) - Lim))))$

/* Γραφήματα (άκρα σε αύξουσα σειρά) */
plot2d([discrete, makelist([N, psum((-1)^(n-1)/n, N)], N, 1, 40)],
       [style, [linespoints, 1, 2]],
       [xlabel, "N"], [ylabel, "S_N"],
       [title, "Enallassousa armoniki -> log(2) = 0.6931"])$

plot2d([discrete, makelist([N, psum(1/n, N)], N, 1, 60)],
       [style, [linespoints, 1, 2]],
       [xlabel, "N"], [ylabel, "H_N"],
       [title, "Armoniki seira: apoklinei san log(N)"])$
