/* Κεφάλαιο 16 — Τεχνικές Ολοκλήρωσης */
/* Ματζάκος, Ν. (2026). Στοιχεία Γραμμικής Άλγεβρας, Διαφορικού & Ολοκληρωτικού Λογισμού. NewTech Publications. */
/* 1. Κατά μέρη */
print("int(x*e^x)         =", integrate(x*exp(x),x));
print("int(x^2*log(x))    =", integrate(x^2*log(x),x));
print("int(e^x*sin(x))    =", radcan(integrate(exp(x)*sin(x),x)));
print("int(atan(x))       =", integrate(atan(x),x));
/* 2. Μερικά κλάσματα */
f1:(2*x+1)/((x-1)*(x+2));
print("Μερικά:", partfrac(f1,x));
print("int =", integrate(f1,x));
f2:x/(x^2-5*x+6);
print("int(x/(x^2-5x+6)) =", integrate(f2,x));
/* 3. Τριγ. αντικατάσταση */
print("int(1/sqrt(1-x^2)) =", integrate(1/sqrt(1-x^2),x));
print("int(sqrt(1-x^2))   =", integrate(sqrt(1-x^2),x));
print("int(1/sqrt(x^2+4)) =", integrate(1/sqrt(x^2+4),x));
/* 4. Τριγωνομετρικά */
print("int(sin^2(x))      =", trigsimp(integrate(sin(x)^2,x)));
print("int(cos^3(x))      =", trigsimp(integrate(cos(x)^3,x)));
print("int(tan(x))        =", integrate(tan(x),x));
/* Επαλήθευση */
r:integrate(x^3*exp(x),x);
print("Επαλήθευση:", ratsimp(diff(r,x)-x^3*exp(x))=0);

/* ============================================================ */
/* ΣΥΜΠΛΗΡΩΜΑ — Αντικατάσταση σε ανεκτέλεστο ολοκλήρωμα         */
/*   changevar(expr, eq, u, x)                                   */
/* ============================================================ */

/* Η changevar δουλεύει σε ΑΝΕΚΤΕΛΕΣΤΟ ολοκλήρωμα ('integrate). */
/* Έτσι βλέπουμε την ίδια την αλλαγή μεταβλητής, όχι μόνο το    */
/* τελικό αποτέλεσμα.                                            */

I1 : 'integrate(2*x*sqrt(x^2 + 1), x)$
print("Αρχικό:", I1)$
print("u = x^2+1 :", changevar(I1, u = x^2 + 1, u, x))$
print("Αποτέλεσμα:", ratsimp(ev(changevar(I1, u = x^2+1, u, x), integrate)))$

/* Όταν η αντικατάσταση δεν αντιστρέφεται μονοσήμαντα (εδώ η    */
/* u=sin(x)), η Maxima προειδοποιεί ότι «χάνονται λύσεις»: αυτό  */
/* αφορά την αντιστροφή, όχι το ίδιο το ολοκλήρωμα.              */
print("")$
I2 : 'integrate(sin(x)^3*cos(x), x)$
print("u = sin(x):", changevar(I2, u = sin(x), u, x))$
print("Αποτέλεσμα:", ev(changevar(I2, u = sin(x), u, x), integrate))$

print("")$
I3 : 'integrate(1/(x*log(x)), x)$
print("u = log(x):", changevar(I3, u = log(x), u, x))$
print("Αποτέλεσμα:", ev(changevar(I3, u = log(x), u, x), integrate))$

/* Σε ορισμένο ολοκλήρωμα η changevar αλλάζει ΚΑΙ τα άκρα.      */
print("")$
I4 : 'integrate(2*x*exp(x^2), x, 0, 1)$
print("Ορισμένο, u = x^2:", changevar(I4, u = x^2, u, x))$
print("Τιμή:", ev(changevar(I4, u = x^2, u, x), integrate),
      "=", float(exp(1) - 1))$
